{
  "mcpServers": {
    "mempalace": {
      "command": "D:/Arjun/Personal/AI/CoPilot CLI/mempalace/.venv/Scripts/python.exe",
      "args": [
        "-m",
        "mempalace.mcp_server"
      ]
    },
    "playwright": {
      "command": "npx",
      "args": [
        "@playwright/mcp@latest"
      ]
    }
  },
  "hooks": {
    "PreCompress": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "D:/Arjun/Personal/AI/CoPilot CLI/mempalace/hooks/mempal_precompact_hook.sh"
          }
        ]
      }
    ],
    "OnSave": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "D:/Arjun/Personal/AI/CoPilot CLI/mempalace/hooks/mempal_save_hook.sh"
          }
        ]
      }
    ]
  }
}